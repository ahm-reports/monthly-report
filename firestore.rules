rules_version = '2';

// قواعد أمان تطبيق التقارير الشهرية.
// كل شي ممنوع إلا اللي مسموح هنا صراحة. (لا تستخدم test mode أبداً)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isActive() { return hasProfile() && me().active == true; }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function canRead(reportId) { return isActive() && me().reports is list && reportId in me().reports; }
    function canWrite(reportId) { return canRead(reportId) && me().role in ['admin', 'editor']; }

    function validUser(d) {
      return d.keys().hasOnly(['username', 'role', 'reports', 'active'])
        && d.username is string && d.role in ['admin', 'editor', 'viewer']
        && d.reports is list && d.active is bool;
    }

    // ---------- المستخدمين ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin() && validUser(request.resource.data);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ---------- التقارير ----------
    match /reports/{reportId} {
      allow read: if canRead(reportId);
      // القالب والإعدادات: المدير فقط (الـ editor يطلب من المدير إضافة الأسماء الجديدة).
      allow create, update: if isAdmin()
        && request.resource.data.displayName is string
        && request.resource.data.feeRate is number
        && request.resource.data.feeRate >= 0 && request.resource.data.feeRate < 1
        && request.resource.data.template is map
        && request.resource.data.template.items is list;

      // ---------- الأشهر ----------
      match /months/{monthId} {
        function validMonth(d) {
          return d.keys().hasOnly(['values', 'other_revenue', 'source', 'updatedAt', 'updatedBy'])
            && d.values is map && d.other_revenue is number
            && d.source in ['raw', 'summary']
            && d.updatedBy == request.auth.uid
            && d.updatedAt == request.time;
        }
        allow read: if canRead(reportId);
        allow create, update: if canWrite(reportId)
          && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && validMonth(request.resource.data);
        allow delete: if isAdmin() && canRead(reportId);

        // ---------- سجل التعديلات: إضافة فقط ----------
        match /log/{logId} {
          allow read: if canRead(reportId);
          allow create: if canWrite(reportId)
            && request.resource.data.keys().hasOnly(['at', 'by', 'key', 'oldValue', 'newValue'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.key is string;
          allow update, delete: if false;
        }
      }
    }
  }
}
